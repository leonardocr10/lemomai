# ------------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# URL pública usada em canonical, Open Graph e sitemap (sem barra no final)
APP_URL=http://localhost:3000
# Segredo para assinar cookies (CSRF). Gere um valor longo e aleatório em produção.
COOKIE_SECRET=troque-este-segredo-em-producao

# ------------------------------------------------------------------
# Fonte de dados
#   true  -> usa src/data/mock (não precisa de MySQL)
#   false -> usa MySQL via Sequelize
# ------------------------------------------------------------------
USE_MOCK_DATA=true

# ------------------------------------------------------------------
# MySQL (usado quando USE_MOCK_DATA=false e pelos comandos db:*)
# ------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lenom_ai
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# ------------------------------------------------------------------
# E-mail
#   MAIL_DRIVER=log  -> apenas registra no console/log (padrão)
#   MAIL_DRIVER=smtp -> envia via SMTP (nodemailer)
# ------------------------------------------------------------------
MAIL_DRIVER=log
MAIL_FROM="Lenom.AI <nao-responda@lenom.ai>"
MAIL_TO_LEADS=contato@lenom.ai
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------------
# Analytics (vazio = desativado). Só carregam após consentimento de cookies.
# ------------------------------------------------------------------
GA_MEASUREMENT_ID=
META_PIXEL_ID=

# ------------------------------------------------------------------
# Segurança / limites
# ------------------------------------------------------------------
# Requisições POST de formulário por IP a cada 15 minutos
FORM_RATE_LIMIT=10
# Tamanho máximo do anexo do orçamento em MB
UPLOAD_MAX_MB=5
# Defina como true atrás de proxy reverso (Nginx, load balancer) para IP correto
TRUST_PROXY=false
