<%# ServiceCard — params: service %>
<a class="card card--hover service-card" href="/servicos/<%= service.slug %>" data-reveal>
  <span class="icon-tile"><%- include('icon', { name: service.icon || 'code' }) %></span>
  <h3><%= service.name %></h3>
  <p><%= service.shortDescription %></p>
  <span class="service-card__arrow" aria-hidden="true"><%- include('icon', { name: 'arrow-right' }) %></span>
  <span class="visually-hidden">Saiba mais sobre <%= service.name %></span>
</a>
