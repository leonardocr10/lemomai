<%# Linhas neon decorativas do fundo (hero e áreas escuras). Cores = tokens --secondary / --accent. %>
<% const w = locals.waveId || "hero"; %>
<svg class="hero__waves" viewBox="0 0 1440 720" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="<%= w %>-a" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#6fd157" stop-opacity="0"/>
      <stop offset=".45" stop-color="#6fd157" stop-opacity=".9"/>
      <stop offset="1" stop-color="#1fa6a0" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="<%= w %>-b" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#1fa6a0" stop-opacity="0"/>
      <stop offset=".6" stop-color="#1fa6a0" stop-opacity=".8"/>
      <stop offset="1" stop-color="#6fd157" stop-opacity="0"/>
    </linearGradient>
    <filter id="<%= w %>-blur"><feGaussianBlur stdDeviation="6"/></filter>
  </defs>
  <path class="wave-glow" d="M-40 560 C 260 470, 460 700, 760 560 S 1240 330, 1500 420" stroke="url(#<%= w %>-a)" stroke-width="10" filter="url(#<%= w %>-blur)" opacity=".5"/>
  <path class="wave-draw" d="M-40 560 C 260 470, 460 700, 760 560 S 1240 330, 1500 420" stroke="url(#<%= w %>-a)" stroke-width="2"/>
  <path class="wave-draw" d="M-40 610 C 300 540, 520 740, 820 600 S 1260 400, 1500 480" stroke="url(#<%= w %>-b)" stroke-width="1.5" opacity=".7"/>
  <path class="wave-glow" d="M900 -20 C 1080 120, 1180 60, 1480 220" stroke="url(#<%= w %>-b)" stroke-width="14" filter="url(#<%= w %>-blur)" opacity=".35"/>
  <path class="wave-draw" d="M900 -20 C 1080 120, 1180 60, 1480 220" stroke="url(#<%= w %>-a)" stroke-width="1.5" opacity=".8"/>
</svg>
