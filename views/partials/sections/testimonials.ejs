<% const s = sections.testimonials; %>
<% if (testimonials.length) { %>
<section class="section section--white" id="depoimentos" aria-labelledby="depoimentos-title">
  <div class="container">
    <%- include('../../components/section-title', { eyebrow: s.eyebrow, title: s.title, highlight: s.highlight, center: true, id: 'depoimentos-title' }) %>
    <div class="grid grid--3">
      <% testimonials.forEach((testimonial) => { %>
        <%- include('../../components/testimonial-card', { testimonial }) %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>
