<%# Hero — segue o banner oficial: fundo tecnológico, headline grande, CTAs fortes, notebook + celular. %>
<%#
  heroMobileOnly: o carrossel de banners ocupa o topo no desktop; o hero aparece só
  no celular e usa h2 (o h1 fica no carrossel).
%>
<% const hero = sections.hero; %>
<% const mobileOnly = Boolean(locals.heroMobileOnly); const titleTag = mobileOnly ? 'h2' : 'h1'; %>
<section class="hero<%= mobileOnly ? ' hero--mobile-only' : '' %>" aria-labelledby="hero-title">
  <%- include('../../components/waves') %>
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow eyebrow--pill"><%= hero.eyebrow %></p>
      <<%= titleTag %> class="hero__title" id="hero-title">
        <%= hero.titleStart %> <span class="text-gradient"><%= hero.titleHighlight %></span>
      </<%= titleTag %>>
      <p class="hero__subtitle"><%= hero.subtitle %></p>

      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="<%= hero.primaryCta.href %>">
          <%- include('../../components/icon', { name: 'bar-chart' }) %>
          <span><%= hero.primaryCta.label %></span>
          <%- include('../../components/icon', { name: 'arrow-right', cls: 'btn__arrow' }) %>
        </a>
        <a class="btn btn--ghost-light btn--lg" href="<%= hero.secondaryCta.href %>">
          <%- include('../../components/icon', { name: 'send' }) %>
          <span><%= hero.secondaryCta.label %></span>
          <%- include('../../components/icon', { name: 'arrow-right', cls: 'btn__arrow' }) %>
        </a>
      </div>

      <ul class="hero__highlights">
        <% hero.highlights.forEach((item) => { %>
          <li>
            <span class="icon-tile icon-tile--dark"><%- include('../../components/icon', { name: item.icon }) %></span>
            <span><strong><%= item.title %></strong><span><%= item.text %></span></span>
          </li>
        <% }) %>
      </ul>
    </div>

    <div class="hero__visual">
      <%- include('../../components/picture', {
        src: '/images/hero/hero-devices',
        widths: [720, 1100],
        fallback: 'jpg',
        sizes: '(max-width: 1080px) 100vw, 55vw',
        alt: 'Notebook e celular exibindo o painel de gestão desenvolvido pela ' + company.companyName,
        width: 1100, height: 733, eager: !mobileOnly
      }) %>
    </div>
  </div>
</section>
