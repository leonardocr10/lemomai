<%# Faixa de destaques logo abaixo do topo da home (sections.highlights). %>
<% const items = sections.highlights || []; %>
<% if (items.length) { %>
  <section class="highlights" aria-label="Por que trabalhar com a <%= company.companyName %>">
    <ul class="container highlights__list">
      <% items.forEach((item) => { %>
        <li class="highlights__item">
          <span class="highlights__icon"><%- include('../../components/icon', { name: item.icon }) %></span>
          <span><strong><%= item.title %></strong><span><%= item.text %></span></span>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>
