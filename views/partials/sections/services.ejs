<% const s = sections.services; %>
<section class="section section--white" id="servicos" aria-labelledby="servicos-title">
  <div class="container split">
    <%- include('../../components/section-title', { eyebrow: s.eyebrow, title: s.title, highlight: s.highlight, subtitle: s.subtitle, id: 'servicos-title' }) %>
    <div class="services-grid">
      <% services.forEach((service) => { %>
        <%- include('../../components/service-card', { service }) %>
      <% }) %>
    </div>
  </div>
</section>
