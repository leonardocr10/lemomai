<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= seo.title %></title>
<% if (seo.description) { %><meta name="description" content="<%= seo.description %>"><% } %>
<% if (seo.noindex) { %>
<meta name="robots" content="noindex, nofollow">
<% } else { %>
<meta name="robots" content="index, follow, max-image-preview:large">
<link rel="canonical" href="<%= seo.canonical %>">
<% } %>
<meta name="theme-color" content="#0f2d4a">
<meta name="format-detection" content="telephone=no">

<%# Open Graph / redes sociais %>
<% if (seo.canonical) { %>
<meta property="og:type" content="<%= seo.type %>">
<meta property="og:site_name" content="<%= seo.siteName %>">
<meta property="og:locale" content="<%= seo.locale %>">
<meta property="og:title" content="<%= seo.title %>">
<meta property="og:description" content="<%= seo.description %>">
<meta property="og:url" content="<%= seo.canonical %>">
<meta property="og:image" content="<%= seo.image %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="<%= company.companyName %> — <%= company.tagline %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= seo.title %>">
<meta name="twitter:description" content="<%= seo.description %>">
<meta name="twitter:image" content="<%= seo.image %>">
<% } %>

<%# Ícones (?v= força navegadores a trocar o favicon antigo em cache) %>
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=lenom">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=lenom">
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=lenom">
<link rel="manifest" href="/site.webmanifest">

<%# Fontes e recursos críticos %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lexend:wght@600;700;800&display=swap">
<link rel="preload" as="image" type="image/webp" href="/images/brand/logo-horizontal.webp">
<% if (locals.preloadBanner) { %>
<link rel="preload" as="image" href="<%= preloadBanner %>" media="(min-width: 768px)" fetchpriority="high">
<% } %>
<% if (locals.preloadHero) { %>
<link rel="preload" as="image" type="image/avif" href="/images/hero/hero-devices-1100.avif" imagesrcset="/images/hero/hero-devices-720.avif 720w, /images/hero/hero-devices-1100.avif 1100w" imagesizes="(max-width: 1080px) 100vw, 55vw" fetchpriority="high">
<% } %>
<link rel="stylesheet" href="<%= asset('css/main.css') %>">
<script src="<%= asset('js/boot.js') %>"></script>

<%# Dados estruturados (schema.org) %>
<% [...baseSchemas, ...(locals.schemas || [])].forEach((schema) => { %>
<script type="application/ld+json"><%- jsonLd(schema) %></script>
<% }) %>
