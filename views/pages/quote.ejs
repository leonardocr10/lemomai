<%
  const v = values || {};
  const e = errors || {};
  const hasErrors = Object.keys(e).length > 0;
  const fieldClass = (name, extra) => 'field' + (e[name] ? ' has-error' : '') + (extra ? ' ' + extra : '');
  const invalid = (name) => e[name] ? 'aria-invalid="true" aria-describedby="quote-' + name + '-error"' : '';
%>
<section class="section quote-page" aria-labelledby="page-title">
  <div class="container quote-page__container">
    <%- include('../components/breadcrumbs', { items: breadcrumbs }) %>

    <header class="quote-head">
      <div class="quote-head__intro">
        <p class="eyebrow">Orçamento personalizado</p>
        <h1 class="quote-head__title" id="page-title">Solicite uma proposta para o seu projeto</h1>
        <p class="quote-head__subtitle">Conte um pouco sobre o seu projeto e receba uma proposta personalizada, sem compromisso, com escopo, prazo e investimento.</p>
      </div>

      <ul class="quote-trust">
        <li>
          <span class="quote-trust__icon"><%- include('../components/icon', { name: 'zap' }) %></span>
          <span class="quote-trust__text">Resposta em<strong>até 1 dia útil</strong></span>
        </li>
        <li>
          <span class="quote-trust__icon"><%- include('../components/icon', { name: 'file-text' }) %></span>
          <span class="quote-trust__text">Proposta sem<strong>compromisso</strong></span>
        </li>
        <li>
          <span class="quote-trust__icon"><%- include('../components/icon', { name: 'lock' }) %></span>
          <span class="quote-trust__text">Seus dados<strong>são protegidos</strong></span>
        </li>
      </ul>
    </header>

    <div class="quote-layout">
      <div class="quote-layout__main">
        <%# Confirmação de sucesso: server-rendered (sem JS) ou revelada pelo envio AJAX. %>
        <div class="quote-success" id="quote-sucesso" tabindex="-1"<%= success ? '' : ' hidden' %>>
          <span class="quote-success__icon"><%- include('../components/icon', { name: 'check-circle' }) %></span>
          <h2>Solicitação enviada com sucesso!</h2>
          <p>Recebemos as informações do seu projeto e entraremos em contato em até 1 dia útil.</p>
          <div class="quote-success__actions">
            <%- include('../components/whatsapp-button') %>
            <%- include('../components/button', { label: 'Voltar ao início', href: '/', variant: 'outline' }) %>
          </div>
        </div>

        <form class="quote-form" action="/orcamento#formulario" method="post" enctype="multipart/form-data" novalidate
              data-ajax-form data-endpoint="/api/quote" data-format="multipart" data-success-panel="#quote-sucesso"
              id="formulario" aria-labelledby="quote-form-title"<%= success ? ' hidden' : '' %>>
          <h2 class="visually-hidden" id="quote-form-title">Formulário de orçamento</h2>

          <% if (hasErrors) { %>
            <div class="alert alert--error" role="alert"><%- include('../components/icon', { name: 'alert' }) %><span>Verifique os campos destacados e tente novamente.</span></div>
          <% } %>

          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="hp-field" aria-hidden="true">
            <label for="quote-website">Não preencha este campo</label>
            <input type="text" id="quote-website" name="website" tabindex="-1" autocomplete="off">
          </div>

          <%# ---------- 1. Seus dados ---------- %>
          <section class="quote-card" aria-labelledby="quote-step-1">
            <header class="quote-card__head">
              <span class="quote-card__step" aria-hidden="true">1</span>
              <div>
                <h3 id="quote-step-1">Seus dados</h3>
                <p>Informe seus dados para entrarmos em contato.</p>
              </div>
            </header>

            <div class="quote-grid">
              <div class="<%= fieldClass('name') %>">
                <label for="quote-name">Nome <span class="req" aria-hidden="true">*</span></label>
                <div class="input-icon">
                  <%- include('../components/icon', { name: 'users', cls: 'input-icon__icon' }) %>
                  <input class="input input--icon" id="quote-name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="120" placeholder="Seu nome completo" value="<%= v.name || '' %>" <%- invalid('name') %>>
                </div>
                <p class="field__error" id="quote-name-error" data-error-for="name"><%= e.name || '' %></p>
              </div>

              <div class="<%= fieldClass('company') %>">
                <label for="quote-company">Empresa <span class="optional">(opcional)</span></label>
                <div class="input-icon">
                  <%- include('../components/icon', { name: 'building', cls: 'input-icon__icon' }) %>
                  <input class="input input--icon" id="quote-company" name="company" type="text" autocomplete="organization" maxlength="120" placeholder="Sua empresa" value="<%= v.company || '' %>" <%- invalid('company') %>>
                </div>
                <p class="field__error" id="quote-company-error" data-error-for="company"><%= e.company || '' %></p>
              </div>

              <div class="<%= fieldClass('email') %>">
                <label for="quote-email">E-mail <span class="req" aria-hidden="true">*</span></label>
                <div class="input-icon">
                  <%- include('../components/icon', { name: 'mail', cls: 'input-icon__icon' }) %>
                  <input class="input input--icon" id="quote-email" name="email" type="email" autocomplete="email" required maxlength="160" placeholder="seu@email.com" value="<%= v.email || '' %>" <%- invalid('email') %>>
                </div>
                <p class="field__error" id="quote-email-error" data-error-for="email"><%= e.email || '' %></p>
              </div>

              <div class="<%= fieldClass('phone') %>">
                <label for="quote-phone">Telefone / WhatsApp <span class="req" aria-hidden="true">*</span></label>
                <div class="input-icon">
                  <%- include('../components/icon', { name: 'whatsapp', cls: 'input-icon__icon' }) %>
                  <input class="input input--icon" id="quote-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required data-mask="phone" placeholder="(11) 90000-0000" value="<%= v.phone || '' %>" <%- invalid('phone') %>>
                </div>
                <p class="field__error" id="quote-phone-error" data-error-for="phone"><%= e.phone || '' %></p>
              </div>
            </div>
          </section>

          <%# ---------- 2. Sobre o projeto ---------- %>
          <section class="quote-card" aria-labelledby="quote-step-2">
            <header class="quote-card__head">
              <span class="quote-card__step" aria-hidden="true">2</span>
              <div>
                <h3 id="quote-step-2">Sobre o projeto</h3>
                <p>Conte mais sobre o que você precisa.</p>
              </div>
            </header>

            <div class="quote-grid">
              <fieldset class="<%= fieldClass('projectType', 'radio-cards') %>" <%- invalid('projectType') %>>
                <legend>Tipo de projeto <span class="req" aria-hidden="true">*</span></legend>
                <% quoteProjectTypes.forEach((option) => { %>
                  <label class="radio-card">
                    <input type="radio" name="projectType" value="<%= option.value %>" required<%= v.projectType === option.value ? ' checked' : '' %>>
                    <span><%= option.label %></span>
                  </label>
                <% }) %>
                <p class="field__error" id="quote-projectType-error" data-error-for="projectType"><%= e.projectType || '' %></p>
              </fieldset>

              <div class="<%= fieldClass('plan') %>">
                <label for="quote-plan">Plano de interesse <span class="optional">(opcional)</span></label>
                <select class="select" id="quote-plan" name="plan">
                  <option value="">Ainda não sei</option>
                  <% plans.forEach((plan) => { %>
                    <option value="<%= plan.slug %>"<%= v.plan === plan.slug ? ' selected' : '' %>><%= plan.category === 'saas' ? 'SaaS — ' : '' %><%= plan.name %> (<%= fmt.planPrice(plan).amount %><%= fmt.planPrice(plan).suffix %>)</option>
                  <% }) %>
                </select>
              </div>

              <div class="<%= fieldClass('objective', 'field--full') %>">
                <label for="quote-objective">Objetivo do projeto <span class="req" aria-hidden="true">*</span></label>
                <textarea class="textarea textarea--compact" id="quote-objective" name="objective" rows="3" required minlength="10" maxlength="5000"
                          placeholder="O que você quer alcançar? Quais funcionalidades são essenciais?&#10;Tem alguma referência?" <%- invalid('objective') %>><%= v.objective || '' %></textarea>
                <p class="field__error" id="quote-objective-error" data-error-for="objective"><%= e.objective || '' %></p>
              </div>
            </div>
          </section>

          <%# ---------- 3. Prazo e investimento ---------- %>
          <section class="quote-card" aria-labelledby="quote-step-3">
            <header class="quote-card__head">
              <span class="quote-card__step" aria-hidden="true">3</span>
              <div>
                <h3 id="quote-step-3">Prazo e investimento</h3>
                <p>Nos conte sua expectativa de prazo e faixa de investimento.</p>
              </div>
            </header>

            <div class="quote-grid">
              <fieldset class="<%= fieldClass('deadline', 'radio-cards') %>" <%- invalid('deadline') %>>
                <legend>Prazo desejado <span class="req" aria-hidden="true">*</span></legend>
                <% deadlines.forEach((option) => { %>
                  <label class="radio-card">
                    <input type="radio" name="deadline" value="<%= option.value %>" required<%= v.deadline === option.value ? ' checked' : '' %>>
                    <span><%= option.label %></span>
                  </label>
                <% }) %>
                <p class="field__error" id="quote-deadline-error" data-error-for="deadline"><%= e.deadline || '' %></p>
              </fieldset>

              <fieldset class="<%= fieldClass('budgetRange', 'radio-cards') %>" <%- invalid('budgetRange') %>>
                <legend>Faixa de investimento <span class="req" aria-hidden="true">*</span></legend>
                <% budgetRanges.forEach((option) => { %>
                  <label class="radio-card">
                    <input type="radio" name="budgetRange" value="<%= option.value %>" required<%= v.budgetRange === option.value ? ' checked' : '' %>>
                    <span><%= option.label %></span>
                  </label>
                <% }) %>
                <p class="field__error" id="quote-budgetRange-error" data-error-for="budgetRange"><%= e.budgetRange || '' %></p>
              </fieldset>

              <div class="<%= fieldClass('attachment', 'field--full') %>">
                <span class="field__label visually-hidden" id="quote-attachment-label">Anexo (opcional)</span>
                <div class="file-drop file-drop--inline" data-file-drop>
                  <span class="file-drop__icon"><%- include('../components/icon', { name: 'paperclip' }) %></span>
                  <span class="file-drop__text">
                    <span class="file-drop__line">
                      <strong>Anexo <span class="optional">(opcional)</span></strong>
                      <span class="file-drop__name" data-file-name>Arraste um arquivo ou clique para selecionar</span>
                    </span>
                    <span class="file-drop__hint">PDF, DOC, XLS, imagens ou ZIP — até <%= maxUploadMb %> MB</span>
                  </span>
                  <span class="file-drop__action"><%- include('../components/icon', { name: 'upload' }) %>Selecionar arquivo</span>
                  <input type="file" id="quote-attachment" name="attachment" accept="<%= attachmentAccept %>" data-max-bytes="<%= maxUploadMb * 1024 * 1024 %>" aria-labelledby="quote-attachment-label" <%- invalid('attachment') %>>
                </div>
                <p class="field__error" id="quote-attachment-error" data-error-for="attachment"><%= e.attachment || '' %></p>
              </div>
            </div>

            <div class="quote-submit">
              <div class="<%= fieldClass('acceptPrivacy') %>">
                <label class="checkbox" for="quote-acceptPrivacy">
                  <input type="checkbox" id="quote-acceptPrivacy" name="acceptPrivacy" required<%= v.acceptPrivacy ? ' checked' : '' %> <%- invalid('acceptPrivacy') %>>
                  <span>Li e concordo com a <a href="/politica-de-privacidade" target="_blank">Política de Privacidade</a> e autorizo o contato da <%= company.companyName %>.</span>
                </label>
                <p class="field__error" id="quote-acceptPrivacy-error" data-error-for="acceptPrivacy"><%= e.acceptPrivacy || '' %></p>
              </div>

              <button class="btn btn--primary quote-submit__btn" type="submit" data-loading-label="Enviando solicitação...">
                <%- include('../components/icon', { name: 'send' }) %><span data-btn-label>Enviar solicitação</span>
                <%- include('../components/icon', { name: 'arrow-right', cls: 'btn__arrow' }) %>
              </button>
            </div>
          </section>
        </form>
      </div>

      <%# ---------- Coluna lateral ---------- %>
      <aside class="quote-aside">
        <section class="quote-steps" aria-labelledby="proximos-passos">
          <h2 id="proximos-passos"><%- include('../components/icon', { name: 'check-circle' }) %>O que acontece depois?</h2>
          <p class="quote-steps__lead">Um processo simples e rápido para tirar o seu projeto do papel.</p>

          <ol class="quote-timeline">
            <li>
              <span class="quote-timeline__icon"><%- include('../components/icon', { name: 'message' }) %></span>
              <div><strong>1. Analisamos sua solicitação</strong><span>em até 1 dia útil.</span></div>
            </li>
            <li>
              <span class="quote-timeline__icon"><%- include('../components/icon', { name: 'users' }) %></span>
              <div><strong>2. Agendamos uma conversa</strong><span>para entender os detalhes.</span></div>
            </li>
            <li>
              <span class="quote-timeline__icon"><%- include('../components/icon', { name: 'file-text' }) %></span>
              <div><strong>3. Enviamos uma proposta</strong><span>com escopo, prazo e investimento.</span></div>
            </li>
          </ol>

          <%- include('../components/whatsapp-button', { block: true }) %>
        </section>

        <% if (company.whatsappUrl) { %>
          <a class="quote-chat" href="<%= company.whatsappUrl %>" target="_blank" rel="noopener noreferrer" data-track="whatsapp">
            <span class="quote-chat__icon"><%- include('../components/icon', { name: 'headset' }) %></span>
            <span class="quote-chat__text">
              <strong>Prefere conversar agora?</strong>
              <span>Tire suas dúvidas e fale diretamente com o nosso time pelo WhatsApp.</span>
            </span>
            <%- include('../components/icon', { name: 'arrow-right', cls: 'quote-chat__arrow' }) %>
          </a>
        <% } %>

        <section class="quote-why" aria-labelledby="quote-why-title">
          <h2 id="quote-why-title">Por que escolher a <%= company.companyName %>?</h2>
          <ul>
            <li>
              <span class="quote-why__icon"><%- include('../components/icon', { name: 'rocket' }) %></span>
              <div><strong>Projetos sob medida</strong><span>Soluções alinhadas aos seus objetivos.</span></div>
            </li>
            <li>
              <span class="quote-why__icon"><%- include('../components/icon', { name: 'bar-chart' }) %></span>
              <div><strong>Comunicação transparente</strong><span>Acompanhamento em todas as etapas.</span></div>
            </li>
            <li>
              <span class="quote-why__icon"><%- include('../components/icon', { name: 'shield' }) %></span>
              <div><strong>Foco em resultados</strong><span>Tecnologia para o crescimento do seu negócio.</span></div>
            </li>
          </ul>
        </section>
      </aside>
    </div>
  </div>
</section>
