<div class="row row-cards">
  <div class="col-lg-8">
    <div class="card mb-3">
      <div class="card-header">
        <h2 class="card-title">Dados do lead</h2>
        <div class="card-actions"><span class="badge <%= adminFmt.leadBadge(lead.status) %>"><%= adminFmt.leadStatus(lead.status) %></span></div>
      </div>
      <div class="card-body">
        <div class="datagrid">
          <div class="datagrid-item">
            <div class="datagrid-title">Recebido em</div>
            <div class="datagrid-content"><%= adminFmt.dateTime(lead.createdAt) %></div>
          </div>
          <% rows.forEach(([label, value]) => { %>
            <div class="datagrid-item">
              <div class="datagrid-title"><%= label %></div>
              <div class="datagrid-content text-break"><%= value %></div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
    <% if (lead.message) { %>
      <div class="card">
        <div class="card-header"><h2 class="card-title">Mensagem</h2></div>
        <div class="card-body"><p class="m-0 text-pre-wrap admin-message"><%= lead.message %></p></div>
      </div>
    <% } %>
  </div>
  <div class="col-lg-4">
    <form class="card mb-3" action="/admin/leads/<%= lead.id %>/status" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-header"><h2 class="card-title">Status</h2></div>
      <div class="card-body">
        <div class="row g-3">
          <%- include('../partials/field', {
            name: 'status', label: 'Status do atendimento', type: 'select', value: lead.status, errors: {}, full: true,
            options: Object.entries(statuses).map(([value, label]) => ({ value, label })),
          }) %>
        </div>
      </div>
      <div class="card-footer">
        <button class="btn btn-primary w-100" type="submit"><i class="ti ti-check icon" aria-hidden="true"></i> Atualizar status</button>
      </div>
    </form>
    <div class="card">
      <div class="card-header"><h2 class="card-title">Responder</h2></div>
      <div class="list-group list-group-flush">
        <% if (lead.email) { %>
          <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="mailto:<%= lead.email %>">
            <i class="ti ti-mail icon text-primary" aria-hidden="true"></i> Enviar e-mail
          </a>
        <% } %>
        <% if (whatsappUrl) { %>
          <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="<%= whatsappUrl %>" target="_blank" rel="noopener">
            <i class="ti ti-brand-whatsapp icon text-green" aria-hidden="true"></i> Chamar no WhatsApp
          </a>
        <% } %>
        <% if (!lead.email && !whatsappUrl) { %><div class="list-group-item text-secondary">Sem contato informado.</div><% } %>
      </div>
    </div>
  </div>
</div>
