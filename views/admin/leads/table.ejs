<%# Tabela simples de leads (painel inicial). A lista completa usa leads/list.ejs. %>
<div class="table-responsive">
  <table class="table table-vcenter card-table">
    <thead><tr><th>Data</th><th>Nome</th><th>E-mail</th><th>Origem</th><th>Status</th></tr></thead>
    <tbody>
      <% leads.forEach((lead) => { %>
        <tr>
          <td class="text-secondary text-nowrap"><%= adminFmt.dateTime(lead.createdAt) %></td>
          <td><a href="/admin/leads/<%= lead.id %>"><%= lead.name || '—' %></a></td>
          <td class="text-secondary"><%= lead.email || '—' %></td>
          <td><%= lead.source === 'quote' ? 'Orçamento' : 'Contato' %></td>
          <td><span class="badge <%= adminFmt.leadBadge(lead.status) %>"><%= adminFmt.leadStatus(lead.status) %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
