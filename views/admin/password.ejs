<div class="row">
  <div class="col-lg-6">
    <form class="card" action="/admin/senha" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-header">
        <h2 class="card-title d-flex align-items-center gap-2"><i class="ti ti-key icon text-primary" aria-hidden="true"></i> Alterar senha de acesso</h2>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <%- include('partials/field', { name: 'currentPassword', label: 'Senha atual', type: 'password', errors, full: true, attrs: ' autocomplete="current-password"' }) %>
          <%- include('partials/field', { name: 'newPassword', label: 'Nova senha', type: 'password', errors, full: true, hint: 'Mínimo de 8 caracteres.', attrs: ' autocomplete="new-password"' }) %>
          <%- include('partials/field', { name: 'confirmPassword', label: 'Confirme a nova senha', type: 'password', errors, full: true, attrs: ' autocomplete="new-password"' }) %>
        </div>
      </div>
      <div class="card-footer d-flex align-items-center">
        <span class="text-secondary small">As outras sessões abertas serão encerradas.</span>
        <button class="btn btn-primary ms-auto" type="submit">Trocar senha</button>
      </div>
    </form>
  </div>
</div>
